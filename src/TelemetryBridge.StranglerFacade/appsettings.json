{
  "TelemetryBridge": {
    "ServiceName": "telemetrybridge-strangler-facade",
    "ServiceNamespace": "telemetrybridge",
    "ServiceVersion": "0.1.0",
    "Otlp": { "Endpoint": "http://localhost:4317", "Protocol": "Grpc" },
    "Tracing": { "Enabled": true, "SamplingMode": "ParentBasedTraceIdRatio", "SamplingRatio": 1.0 },
    "Metrics": { "Enabled": true },
    "Logging": { "Enabled": true, "IncludeFormattedMessage": true, "IncludeScopes": true }
  },
  "Backends": {
    "Modern": "http://localhost:8081/",
    "Legacy": "http://localhost:8083/"
  },
  "Migration": {
    "FilePath": "data/migration.json"
  }
}
